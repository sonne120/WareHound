<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

    <!-- Networking -->
    <PackageReference Include="SharpPcap" Version="6.3.0" />
    <PackageReference Include="PacketDotNet" Version="1.4.7" />

    <!-- Mapping -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

    <!-- gRPC -->
    <PackageReference Include="Google.Protobuf" Version="3.29.0-rc2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0-pre1" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.67.0-pre1" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="8.0.1" />

    <!-- Charting for Avalonia -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc2" />
  </ItemGroup>

  <!-- Protobuf from WareHound.UI -->
  <PropertyGroup>
    <WareHoundUIProjectRoot>$(MSBuildProjectDirectory)\..\WareHound.UI\</WareHoundUIProjectRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(WareHoundUIProjectRoot)Protos\sniffering.proto" GrpcServices="Client" ProtoRoot="$(WareHoundUIProjectRoot)" />
  </ItemGroup>

  <!-- Native Sniffer Build Configuration -->
  <!-- CI builds the sniffer itself (per architecture) and passes -p:SkipNativeSnifferBuild=true -->
  <PropertyGroup>
    <SkipNativeSnifferBuild Condition="'$(SkipNativeSnifferBuild)' == ''">false</SkipNativeSnifferBuild>
    <WareHoundSolutionDir Condition="'$(SolutionDir)' != '' AND !$(SolutionDir.Contains('*Undefined*'))">$(SolutionDir)</WareHoundSolutionDir>
    <WareHoundSolutionDir Condition="'$(WareHoundSolutionDir)' == ''">$(ProjectDir)..\</WareHoundSolutionDir>
    <SnifferProjectDir>$(WareHoundSolutionDir)WareHound.Sniffer\</SnifferProjectDir>
    <NativeLibraryName Condition="'$(OS)' == 'Windows_NT'">WareHound.Sniffer.dll</NativeLibraryName>
    <NativeLibraryName Condition="'$(OS)' != 'Windows_NT' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">libWareHound.Sniffer.dylib</NativeLibraryName>
    <NativeLibraryName Condition="'$(OS)' != 'Windows_NT' AND '$(NativeLibraryName)' == ''">libWareHound.Sniffer.so</NativeLibraryName>
  </PropertyGroup>

  <!-- Build Native Sniffer Library (Windows) -->
  <Target Name="BuildNativeSnifferWindows" BeforeTargets="Build" Condition="'$(SkipNativeSnifferBuild)' != 'true' AND '$(OS)' == 'Windows_NT' AND Exists('$(SnifferProjectDir)WareHound.Sniffer.vcxproj')">
    <Message Text="Building WareHound.Sniffer (Windows) for $(Configuration)..." Importance="high" />
    <MSBuild Projects="$(SnifferProjectDir)WareHound.Sniffer.vcxproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Build" />
  </Target>

  <!-- Build Native Sniffer Library (Unix with CMake) -->
  <Target Name="BuildNativeSnifferUnix" BeforeTargets="Build" Condition="'$(SkipNativeSnifferBuild)' != 'true' AND '$(OS)' != 'Windows_NT' AND Exists('$(SnifferProjectDir)CMakeLists.txt')">
    <Message Text="Building WareHound.Sniffer (Unix) for $(Configuration)..." Importance="high" />

    <!-- Create build directory if it doesn't exist -->
    <MakeDir Directories="$(SnifferProjectDir)build" />

    <!-- Run CMake configure (only if needed) -->
    <Exec Command="cmake .." WorkingDirectory="$(SnifferProjectDir)build" Condition="!Exists('$(SnifferProjectDir)build/Makefile')" />

    <!-- Build with CMake -->
    <Exec Command="cmake --build . --config $(Configuration)" WorkingDirectory="$(SnifferProjectDir)build" />
  </Target>

  <!-- Copy Native DLL/Dylib/SO to Output Directory -->
  <Target Name="CopyNativeLibrary" AfterTargets="Build" Condition="'$(SkipNativeSnifferBuild)' != 'true'">
    <!-- Windows: Copy from bin\Configuration\ -->
    <Copy SourceFiles="$(WareHoundSolutionDir)bin\$(Configuration)\$(NativeLibraryName)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'$(OS)' == 'Windows_NT' AND Exists('$(WareHoundSolutionDir)bin\$(Configuration)\$(NativeLibraryName)')" />

    <!-- Unix: Copy from build directory -->
    <Copy SourceFiles="$(SnifferProjectDir)build\$(NativeLibraryName)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'$(OS)' != 'Windows_NT' AND Exists('$(SnifferProjectDir)build\$(NativeLibraryName)')" />

    <!-- Fallback: Try to copy from Sniffer root directory -->
    <Copy SourceFiles="$(SnifferProjectDir)$(NativeLibraryName)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SnifferProjectDir)$(NativeLibraryName)') AND !Exists('$(OutputPath)$(NativeLibraryName)')" />

    <!-- Log success or warning -->
    <Message Text="✅ Copied $(NativeLibraryName) to $(OutputPath)" Importance="high" Condition="Exists('$(OutputPath)$(NativeLibraryName)')" />
    <Warning Text="⚠️ Native library $(NativeLibraryName) not found. Build it manually: cmake -S $(SnifferProjectDir) -B $(SnifferProjectDir)build &amp;&amp; cmake --build $(SnifferProjectDir)build" Condition="!Exists('$(OutputPath)$(NativeLibraryName)')" />
  </Target>

  <!-- Include native library in publish -->
  <ItemGroup Condition="'$(SkipNativeSnifferBuild)' != 'true'">
    <None Include="$(OutputPath)$(NativeLibraryName)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OutputPath)$(NativeLibraryName)')" />
  </ItemGroup>

</Project>
