<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WareHound.Avalonia.Views.PacketDetailWindow"
        Title="Packet Details"
        Height="380" Width="650"
        MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBrush}"
        CanResize="True">

    <Window.Styles>
        <Style Selector="TextBlock.detail-label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.detail-value">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderProtocol" Text="TCP" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HeaderTime" Text="00:00:00.000" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="3"
                        Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderPacketNo" Text="Packet #1" Foreground="White" FontWeight="Medium" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" Margin="10">
            <TabItem Header="Details">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SecondaryBrush}" CornerRadius="4"
                            Padding="8" Margin="0,0,4,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="NETWORK" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Src IP:" Classes="detail-label"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourceIp" Text="0.0.0.0" Classes="detail-value"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dst IP:" Classes="detail-label"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DestIp" Text="0.0.0.0" Classes="detail-value"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Src Port:" Classes="detail-label"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SourcePort" Text="0" Classes="detail-value"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dst Port:" Classes="detail-label"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DestPort" Text="0" Classes="detail-value"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="4"
                            Padding="8" Margin="4,0,0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DATA LINK" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Src MAC:" Classes="detail-label"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourceMac" Text="00:00:00:00:00:00" Classes="detail-value"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dst MAC:" Classes="detail-label"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DestMac" Text="00:00:00:00:00:00" Classes="detail-value"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SecondaryBrush}" CornerRadius="4"
                            Padding="8" Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INFO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="Protocol:" Classes="detail-label"/>
                                    <TextBlock x:Name="Protocol" Text="TCP" Classes="detail-value"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="ID:" Classes="detail-label"/>
                                    <TextBlock x:Name="PacketId" Text="0" Classes="detail-value"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="Host:" Classes="detail-label"/>
                                    <TextBlock x:Name="HostName" Text="Unknown" Classes="detail-value"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Time:" Classes="detail-label"/>
                                    <TextBlock x:Name="CaptureTime" Text="00:00:00" Classes="detail-value"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Hex Dump">
                <Border Background="{StaticResource SecondaryBrush}" CornerRadius="6"
                        Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="HexDump"
                                   FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="11" Padding="10"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="00000000  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  ................"/>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Button Content="Close" HorizontalAlignment="Right"
                        Padding="16,5" FontSize="12" Click="CloseButton_Click"
                        Background="{StaticResource TertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
