<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WareHound.Avalonia.ViewModels"
             xmlns:conv="using:WareHound.Avalonia.Converters"
             x:Class="WareHound.Avalonia.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel"
             Background="{StaticResource PrimaryBrush}">

    <UserControl.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidth"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈 Statistics"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatsSourceText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Classes="control"
                                Command="{Binding RefreshCommand}"
                                Content="↻ Refresh"
                                Padding="12,6"
                                Margin="0,0,8,0"/>
                        <Button Classes="control"
                                Command="{Binding ToggleStatsSourceCommand}"
                                Content="Toggle Source"
                                Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,16,0,0">
                <Border Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Packets"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TotalPackets, StringFormat='{}{0:N0}'}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Packets/Sec"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding PacketsPerSecond, StringFormat='{}{0:N1}'}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Capture Time"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CaptureTime}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Protocols"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding UniqueProtocols}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Unique IPs"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding UniqueIPs}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Protocol Breakdown"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ProtocolStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProtocolStats">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Protocol}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource TertiaryBrush}"
                                                CornerRadius="4"
                                                Height="16"
                                                Margin="8,0">
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Percentage, Converter={StaticResource PercentToWidth}}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PacketCount, StringFormat='{}{0:N0}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Top Source IPs"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopSourceIPs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TalkerInfo">
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding IP}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding PacketCount, StringFormat='{}{0:N0}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2"
                                   Text="Top Destination IPs"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,16,0,8"/>

                        <ItemsControl Grid.Row="3" ItemsSource="{Binding TopDestIPs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TalkerInfo">
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding IP}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding PacketCount, StringFormat='{}{0:N0}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Top Ports"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PortInfo">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Display}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PacketCount, StringFormat='{}{0:N0}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
