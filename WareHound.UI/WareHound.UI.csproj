<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentWPF" Version="0.10.2" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="Prism.Core" Version="8.1.97" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.*" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
    <PackageReference Include="PacketDotNet" Version="1.4.7" />
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Google.Protobuf" Version="3.29.0-rc2" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.29.0-rc2" />
    <PackageReference Include="Grpc" Version="2.46.6" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0-pre1" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.67.0-pre1" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0-rc.2.24473.5" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="8.0.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\sniffering.proto" GrpcServices="Client" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Protos\sniffering.proto" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- C++ project must be built separately with MSBuild/Visual Studio -->
  <!--
  <ItemGroup>
    <ProjectReference Include="..\WareHound.Sniffer\WareHound.Sniffer.vcxproj" />
  </ItemGroup>
  -->

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <WareHoundSolutionDir Condition="'$(SolutionDir)' != '' AND !$(SolutionDir.Contains('*Undefined*'))">$(SolutionDir)</WareHoundSolutionDir>
    <WareHoundSolutionDir Condition="'$(WareHoundSolutionDir)' == ''">$(ProjectDir)..\</WareHoundSolutionDir>
  </PropertyGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy SourceFiles="$(WareHoundSolutionDir)bin\$(Configuration)\WareHound.Sniffer.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(WareHoundSolutionDir)bin\$(Configuration)\WareHound.Sniffer.dll')" />
  </Target>

  <Target Name="EnsureProtobufFiles" BeforeTargets="_Protobuf_CoreCompile" Condition="$(MSBuildProjectFile.Contains('wpftmp'))">
    <PropertyGroup>
       <DebugIsTempProject>$(MSBuildProjectFile.Contains('wpftmp'))</DebugIsTempProject>
       <DebugPDir>$(MSBuildProjectDirectory)</DebugPDir>
       <SDir>$(SolutionDir)</SDir>
       <SDir Condition="'$(SDir)' == '' OR '$(SDir)' == '*Undefined*'">$(MSBuildProjectDirectory)\..\..\..\..\..\</SDir>
    </PropertyGroup>

    <Message Text="[Fix] Debug Info: IsTemp=$(DebugIsTempProject), PDir=$(DebugPDir), SDir=$(SDir)" Importance="high" />

    <ItemGroup>
      <!-- Strategy: Look for Protos in likely locations relative to the temp project in obj folder -->
      <!-- 1. One level up (if temp proj is in WareHound.UI/) -->
      <ProtoCandidates Include="$(MSBuildProjectDirectory)\..\Protos\**\*.proto" />
      <!-- 2. Typical obj location: WareHound.UI/obj/ (so go up 1 level) -->
      <ProtoCandidates Include="$(MSBuildProjectDirectory)\..\Protos\**\*.proto" />
      <!-- 3. Deeper obj location (e.g. obj/x64/Release...) -->
      <ProtoCandidates Include="$(MSBuildProjectDirectory)\..\..\Protos\**\*.proto" />
      <ProtoCandidates Include="$(MSBuildProjectDirectory)\..\..\..\Protos\**\*.proto" />
      <ProtoCandidates Include="$(MSBuildProjectDirectory)\..\..\..\..\Protos\**\*.proto" />
      <!-- 4. Explicit solution path -->
      <ProtoCandidates Include="$(SDir)WareHound.UI\Protos\**\*.proto" />
    </ItemGroup>

    <Message Text="[Fix] Found @(ProtoCandidates->Count()) candidate proto files." Importance="high" />

    <Copy SourceFiles="@(ProtoCandidates)" DestinationFolder="$(MSBuildProjectDirectory)\Protos" SkipUnchangedFiles="true" />
  </Target>

</Project>
