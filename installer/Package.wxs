<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="WareHound"
           Manufacturer="WareHound Team"
           Version="$(var.AppVersion)"
           UpgradeCode="B1E5D2A0-7C34-4F9B-8E61-9A2D3C4B5F60"
           Scope="perMachine"
           Compressed="yes">

    <!-- Clean major-upgrade: uninstall any previous version first. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install locations -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WareHound" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="WareHound" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="WareHound" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcuts" />
    </Feature>

    <!-- Start menu + desktop shortcuts -->
    <Component Id="AppShortcuts" Directory="AppProgramMenuDir" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="WareHound"
                Target="[INSTALLFOLDER]WareHound.UI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="WareHound"
                Target="[INSTALLFOLDER]WareHound.UI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\WareHound" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Modern install-dir wizard UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ============================================================
         Packet-capture driver (Npcap / WinPcap) prerequisite check.
         WareHound needs a pcap driver to capture traffic. We detect it
         via its service registry key (the Services hive is not subject
         to WOW64 redirection, so this works regardless of install mode).
         If neither Npcap nor WinPcap is present, the npcap.com download
         page is opened at the end of a successful install. ============ -->
    <Property Id="NPCAPINSTALLED">
      <RegistrySearch Id="NpcapService" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\npcap"
                      Name="ImagePath" Type="raw" />
    </Property>
    <Property Id="WINPCAPINSTALLED">
      <RegistrySearch Id="WinPcapService" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\npf"
                      Name="ImagePath" Type="raw" />
    </Property>

    <!-- ShellExecute "open" on the URL -> launches the default browser. -->
    <SetProperty Id="WixShellExecTarget" Value="https://npcap.com/#download"
                 Before="OpenNpcapDownloadPage" Sequence="execute" />
    <CustomAction Id="OpenNpcapDownloadPage" BinaryRef="Wix4UtilCA_X86"
                  DllEntry="WixShellExec" Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="OpenNpcapDownloadPage" After="InstallFinalize"
              Condition="NOT NPCAPINSTALLED AND NOT WINPCAPINSTALLED AND NOT Installed" />
    </InstallExecuteSequence>

  </Package>

  <!-- The AppFiles ComponentGroup is generated at build time by the
       HarvestDirectory item in WareHound.wixproj (rooted at INSTALLFOLDER). -->

</Wix>
